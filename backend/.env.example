# Postgres (docker compose up -d starts one on 5433)
DATABASE_URL=postgres://zj:zj@127.0.0.1:5433/zj_backend
# Shared secret; the storefront's BACKEND_SERVICE_TOKEN must match. Min 32 chars (openssl rand -base64 48)
BACKEND_SERVICE_TOKEN=
# Where the service listens
HOST=127.0.0.1
PORT=4000
# Shopify webhooks (POST /webhooks/shopify): the signing secret from Shopify admin →
# Settings → Notifications → Webhooks ("Your webhooks will be signed with …")
SHOPIFY_WEBHOOK_SECRET=
# Storefront origin, called at POST /api/revalidate to clear the catalog cache
STOREFRONT_URL=http://localhost:3000
# Catalog sync (products in Postgres): Storefront API access, same values as the storefront's
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Admin API (Dev Dashboard app, client credentials). Without these, Admin stays off.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# Pinned GraphQL Admin API version
SHOPIFY_ADMIN_API_VERSION=2026-10
# Public origin of this API (used by npm run webhooks:register for app subscriptions)
BACKEND_PUBLIC_URL=
# Error reporting (optional). Without SENTRY_DSN, Sentry is off and nothing changes.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# 1 turns on GET /v1/debug/sentry (throws on purpose to test Sentry). Leave unset in production.
SENTRY_DEBUG=
# Staff admin API (/admin/*), used by the admin app. Leave all unset to keep it off.
# Each secret ≥32 chars and different from every other (openssl rand -base64 48).
ADMIN_API_TOKEN=
ADMIN_API_TOKEN_PREVIOUS=
ADMIN_JWT_SECRET=
ADMIN_JWT_SECRET_PREVIOUS=
# email:role entries (viewer | operator | admin), comma separated
ADMIN_ALLOWLIST=
# The admin app's Google OAuth client id; optional Workspace domain restriction
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_HOSTED_DOMAIN=
