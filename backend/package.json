{
  "name": "zj-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --import ./dist/instrument.js dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/migrate.js",
    "catalog:backfill": "tsx --env-file-if-exists=.env src/catalog/backfill.ts",
    "catalog:backfill:prod": "node --env-file-if-exists=.env dist/catalog/backfill.js",
    "inventory:backfill": "tsx --env-file-if-exists=.env src/inventory/backfill.ts",
    "inventory:backfill:prod": "node --env-file-if-exists=.env dist/inventory/backfill.js",
    "orders:backfill": "tsx --env-file-if-exists=.env src/orders/backfill.ts",
    "orders:backfill:prod": "node --env-file-if-exists=.env dist/orders/backfill.js",
    "webhooks:register": "tsx --env-file-if-exists=.env src/webhooks/register.ts",
    "admin:token": "tsx --env-file-if-exists=.env src/admin/dev-token.ts",
    "sync:shared": "rm -rf src/catalog-shared && cp -R ../lib/catalog-shared src/catalog-shared"
  },
  "dependencies": {
    "@sentry/node": "11.16.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "jose": "6.2.14",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
