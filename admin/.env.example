# Admin app (server-side only — none of these reach the browser).
# The backend API and the token it expects for /admin/* (same value as the backend's ADMIN_API_TOKEN)
BACKEND_URL=http://127.0.0.1:4000
ADMIN_API_TOKEN=
# Google OAuth client ("Web application"); redirect URI: {ADMIN_APP_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the session cookie; ≥32 chars (openssl rand -base64 48). Rotating it signs everyone out.
ADMIN_SESSION_SECRET=
# This app's public origin (no trailing slash)
ADMIN_APP_URL=http://localhost:3001
# Optional error reporting (scrubbed: no cookies, tokens or plain-text emails)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
