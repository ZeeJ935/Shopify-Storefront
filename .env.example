# Storefront API (server-only — never NEXT_PUBLIC_)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Public storefront origin (sitemap, metadata, logout return)
SITE_URL=https://your-storefront.example.com

# Customer Account API (Headless channel — confidential client)
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
SHOPIFY_CUSTOMER_ACCOUNT_SHOP_ID=
# Must match Headless channel callback URL(s) exactly
SHOPIFY_CUSTOMER_ACCOUNT_CALLBACK_URL=https://your-storefront.example.com/account/callback
# Optional; defaults to SITE_URL or callback origin
SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_REDIRECT_URL=https://your-storefront.example.com/
# Min 32 characters — used to encrypt httpOnly session cookies
SHOPIFY_CUSTOMER_ACCOUNT_SESSION_SECRET=
