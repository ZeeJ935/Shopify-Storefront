# Storefront API (server-only — never NEXT_PUBLIC_)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Optional: Storefront namespace of zj-discount-engine's public offers metafield
# (app--<app id>). Defaults to the current app; set only if the app is recreated.
# SHOPIFY_OFFERS_NAMESPACE=app--451440410625

# Public storefront origin (sitemap, metadata, logout return)
SITE_URL=https://your-storefront.example.com

# Customer Account API (Headless channel — confidential client)
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
SHOPIFY_CUSTOMER_ACCOUNT_SHOP_ID=
# Must match Headless channel callback URL(s) exactly
SHOPIFY_CUSTOMER_ACCOUNT_CALLBACK_URL=https://your-storefront.example.com/account/callback
# Optional; defaults to SITE_URL or callback origin
SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_REDIRECT_URL=https://your-storefront.example.com/
# Min 32 characters — used to encrypt httpOnly session cookies
SHOPIFY_CUSTOMER_ACCOUNT_SESSION_SECRET=

# Optional; shows a "Need help?" email button on order pages when set
SUPPORT_EMAIL=

# Backend service (see backend/README.md). Called from the Next.js server only.
BACKEND_URL=http://127.0.0.1:4000
# Must match the backend's BACKEND_SERVICE_TOKEN. Min 32 characters.
# Also protects POST /api/revalidate, which the backend calls after catalog webhooks.
BACKEND_SERVICE_TOKEN=

# Shared rate limiting (Upstash Redis, sliding window) across all server instances.
# Leave both empty locally: the in-memory limiter is used instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error reporting with Sentry (optional). Without these, Sentry is off and nothing changes.
# Server-side DSN, and the browser DSN (usually the same value).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: upload source maps at build time for readable stack traces (all three needed).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Local testing only: set to 1 to enable GET /api/debug/sentry, which throws on purpose.
SENTRY_DEBUG=

# Content-Security-Policy: Report-Only by default. Set to 1 to enforce it (see README).
CSP_ENFORCE=
